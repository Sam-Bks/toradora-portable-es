msgid "Ryuuji「You're right, there's the option of＿asking her over the phone...... But with＿the way she was acting, I think it's best」"
msgstr "Ryuuji「Tienes razón, puedo preguntarle por＿teléfono...... Pero por cómo actuaba,＿creo que lo mejor es」"

msgid "Ryuuji「to give her some space for today.」"
msgstr "Ryuuji「darle algo de espacio por hoy.」"

msgid "Ryuuji「......*Gasp*! Are you trying to say＿\"something painful\"? Inko-chan, do you＿know something about it......? Yeah,」"
msgstr "Ryuuji「......¡Ah! ¿Intentas decir \"algo＿doloroso\"? Inko-chan, ¿acaso sabes＿algo al respecto......? Sí,」"

msgid "Ryuuji「right.」"
msgstr "Ryuuji「claro.」"
