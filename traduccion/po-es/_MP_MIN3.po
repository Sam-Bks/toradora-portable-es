msgid "Minori「Look, Takasu-kun. From what I can tell,＿you've recovered more than enough＿already. Don't you think it's better not」"
msgstr "Minori「Mira, Takasu-kun. Por lo que＿veo, ya te recuperaste de＿sobra. ¿No crees que es mejor」"

msgid "Minori「to force things?」"
msgstr "Minori「no forzar las cosas?」"

msgid "Minori「You mustn't make light of the great＿Kushieda Minori's strength! If I have＿free time, it means I'm not working」"
msgstr "Minori「¡No subestimes la fuerza de la＿gran Kushieda Minori! ¡Si tengo＿tiempo libre, es que no trabajo」"

msgid "Minori「enough!」"
msgstr "Minori「lo suficiente!」"

msgid "Minori「When I think about parting ways with＿the classmates we've spent a whole＿year with, through thick and thin, it's」"
msgstr "Minori「Cuando pienso en despedirnos de los＿compañeros con los que pasamos todo un＿año, en las buenas y las malas, es」"

msgid "Minori「kinda sad......」"
msgstr "Minori「un poco triste......」"
