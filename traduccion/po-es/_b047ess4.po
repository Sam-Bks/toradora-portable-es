msgid "Ryuuji「\"Do what you want\"......? You mean I can＿make oyakodon out of you? No, there's＿no way...... which means......」"
msgstr "Ryuuji「¿\"Haz lo que quieras\"......? ¿O sea que＿puedo hacer oyakodon contigo? No, no＿puede ser...... lo que significa......」"

msgid "Inko-chan「*POSE*......」"
msgstr "Inko-chan「*POSE*......」"

msgid "Ryuuji「N-No, no way...... You're a bird, and I'm a＿human...... Even if I wanted to, it's＿just......」"
msgstr "Ryuuji「N-No, de ninguna manera...... Tú eres＿un pájaro y yo un humano...... Aunque＿quisiera, simplemente......」"
