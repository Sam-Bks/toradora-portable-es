msgid "Taiga「You haven't made any progress, so I＿was just wishing for you to get your＿memory back.」"
msgstr "Taiga「No has avanzado nada, así que＿solo estaba deseando que recuperaras＿la memoria.」"

msgid "Taiga「I went out of my way to accompany＿you, and this is how you talk to me?」"
msgstr "Taiga「¿Me tomé la molestia de acompañarte,＿y así es como me hablas?」"

msgid "Taiga「I picked up a ridiculous mongrel,＿trained it, and just when I thought it＿was improving, I had to start over!」"
msgstr "Taiga「¡Recogí a un perro absurdo,＿lo entrené, y justo cuando mejoraba,＿empecé de cero!」"

msgid "Taiga「What a load of crap!」"
msgstr "Taiga「¡Qué porquería!」"

msgid "Taiga「I feel like, for better or worse, we＿overcame it together, you know?＿Though it was-- it was a little」"
msgstr "Taiga「Siento que, para bien o para＿mal, lo superamos juntos, ¿sabes?＿Aunque fue un poco」"

msgid "Taiga「frustrating.」"
msgstr "Taiga「frustrante.」"

msgid "Taiga「I don't give a rat's ass what everyone is＿like. Now let me ask you something.」"
msgstr "Taiga「Me importa un comino cómo sean los＿demás. Ahora déjame preguntarte algo.」"

msgid "Taiga「What were you trying to accomplish by＿saying something so useless?」"
msgstr "Taiga「¿Qué intentabas lograr diciendo＿algo tan inútil?」"

msgid "Taiga「Well, we still have to buy souvenirs for＿Yacchan. Mini sponge cakes, and＿sweet chestnuts, and apricot candy......」"
msgstr "Taiga「Aún debemos comprar recuerdos para＿Yacchan. Bizcochos, castañas y caramelo＿de albaricoque......」"

msgid "Taiga「Oh my god! Tons to look forward to!」"
msgstr "Taiga「¡Dios mío! ¡Cuánto por disfrutar!」"
