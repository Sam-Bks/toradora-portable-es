msgid "Ryuuji「K-Killer!? The smell isn't from a＿corpse, it's from the laundry! Calm＿down, Inko-chan, or the neighbors will」"
msgstr "Ryuuji「¡¿A-Asesino?! ¡Huele a ropa lavada,＿no a cadáver! ¡Cálmate, Inko-chan,＿o los vecinos」"

msgid "Ryuuji「get the wrong idea!」"
msgstr "Ryuuji「se harán una idea equivocada!」"

msgid "Ryuuji「Yeah, that's right! I'm the kinda guy＿who spends a whole year looking＿forward to grocery store mystery bags!」"
msgstr "Ryuuji「¡Sí, así es! ¡Soy el tipo de chico que＿se pasa todo el año esperando las bolsas＿sorpresa del supermercado!」"

msgid "Ryuuji「So what?」"
msgstr "Ryuuji「¿Y qué?」"

msgid "Ryuuji「Wait. You can't say stuff like \"no point＿or \"not possible\" in front of Taiga. Also,＿stuff like \"ripoff\" and \"snake oil\" and」"
msgstr "Ryuuji「Espera. No puedes decir cosas como \"no＿sirve\" o \"imposible\" frente a Taiga.＿Además, \"estafa\", \"fraude\" y」"

msgid "Ryuuji「\"waste of money\" are now taboo.」"
msgstr "Ryuuji「\"desperdicio de dinero\" ahora son tabú.」"
